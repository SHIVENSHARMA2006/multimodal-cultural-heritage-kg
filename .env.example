# Multimodal Cultural Heritage Knowledge Graph Configuration

# Hugging Face Token (Optional, for higher rate limits on HF models)
HF_TOKEN=

# GroqCloud API Key (Optional, for fast LLM inference)
GROQ_API_KEY=

# Google AI Studio API Key (Optional, for Gemini 2.0 Flash / Pro)
GEMINI_API_KEY=

# Neo4j Graph Database (Optional: falls back to embedded NetworkX engine if empty)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Embedding Model for Semantic Entity Matching and Divergence Scoring
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Divergence Thresholds
DIVERGENCE_THRESHOLD=0.55
ENTITY_MATCH_THRESHOLD=0.5